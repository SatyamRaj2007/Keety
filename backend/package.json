{
  "name": "keety-backend",
  "version": "1.0.0",
  "private": true,
  "description": "KEETY REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"tests/api/**/*.test.js\" \"tests/unit/**/*.test.js\"",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:api": "node --test tests/api/**/*.test.js",
    "test:eval": "node --test tests/ai-eval/eval.test.js",
    "test:coverage": "node --experimental-test-coverage --test \"tests/api/**/*.test.js\" \"tests/unit/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "pino": "^10.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true
  }
}
