# Shared deployment template for local staging / Docker-based deployment
# Copy this file to a real .env file and replace placeholders before running the stack.

# Backend runtime
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://mongo:27017/keety?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLIENT_ORIGIN=http://localhost

# Frontend runtime
VITE_API_URL=http://localhost:5000/api
